{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Edit(./answers.csv)"
    ],
    "deny": [
      "Read(//c/Users/Fernando/Documents/answer-key-private/**)",
      "Edit(//c/Users/Fernando/Documents/answer-key-private/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Bash|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/official_sites_only.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|mcp__claude-in-chrome__navigate",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/track_sources.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_answers.py\""
          }
        ]
      }
    ]
  }
}